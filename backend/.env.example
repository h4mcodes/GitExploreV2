# GitExplore V2 Backend Environment Variables

# Server Configuration
PORT=4000
NODE_ENV=development

# Client CORS Configuration
CORS_ORIGIN=http://localhost:5173

# GitHub API Token (Optional for dev, elevates rate limit to 5,000 req/hr)
GITHUB_TOKEN=

# Database Configuration (Planned for D2)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gitexplore?schema=public

# AI Provider Configuration (Planned for D4)
AI_PROVIDER=mock
AI_API_KEY=

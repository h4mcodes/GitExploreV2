# GitExplore V2 Backend Environment Variables

# Server Configuration
PORT=4000
NODE_ENV=development

# Client CORS Configuration
CORS_ORIGIN=http://localhost:5173

# GitHub API Token (Optional for dev, elevates rate limit to 5,000 req/hr)
GITHUB_TOKEN=

# Database Configuration (Planned for D2)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gitexplore?schema=public

# Authentication Secret Key (Required for JWT signing)
JWT_SECRET=gitexplore-v2-dev-secret-key-32-chars-minimum-token

# AI Provider Configuration (Google Gemini via Google AI Studio)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash


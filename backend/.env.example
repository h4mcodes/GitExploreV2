# ==============================================================================
# GitExplore V2 — Production & Development Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
# Port for the Node.js / Express backend server.
PORT=4000

# Node runtime environment: 'development', 'production', or 'test'.
# In production, sets strict security headers and suppresses internal error stacks.
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
# For production, specify your deployed frontend domain(s).
# Example: https://gitexplore.vercel.app,http://localhost:5173
CORS_ORIGIN=https://gitexplore.vercel.app,http://localhost:5173

# ------------------------------------------------------------------------------
# 3. Database Persistence (Neon PostgreSQL Free Plan)
# ------------------------------------------------------------------------------
# Neon cloud PostgreSQL connection string (pooled connection recommended).
# Format: postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require
# For local development with Postgres:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gitexplore?schema=public
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 4. Authentication & JWT Security
# ------------------------------------------------------------------------------
# Secret key used for signing and verifying JSON Web Tokens (JWT).
# MUST be a cryptographically secure random string of at least 32 characters in production.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-secure-random-secret-key-at-least-32-chars-minimum

# ------------------------------------------------------------------------------
# 5. GitHub API Authentication (Proxy & Data Ingestion)
# ------------------------------------------------------------------------------
# Optional GitHub Personal Access Token (classic or fine-grained).
# Without a token, GitHub REST API enforces an unauthenticated limit of 60 req/hr per IP.
# With a token, rate limits elevate to 5,000 req/hr.
GITHUB_TOKEN=

# ------------------------------------------------------------------------------
# 6. AI Intelligence Engine (Google Gemini via Google AI Studio)
# ------------------------------------------------------------------------------
# Pluggable AI provider: 'gemini' (production default) or 'mock' (offline test runner).
AI_PROVIDER=gemini

# Google Gemini API Key from Google AI Studio (https://aistudio.google.com/).
# Required for live AI features (Repository Overview, Code Review, Branch Analysis, Q&A).
GEMINI_API_KEY=

# Gemini model identifier (e.g. gemini-1.5-flash or gemini-1.5-pro).
GEMINI_MODEL=gemini-1.5-flash

// Prisma Schema for GitExplore V2
// Documentation: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TargetType {
  COMMIT
  BRANCH
  DIFF
  REPOSITORY
  FILE
  COMPARISON
}

enum AnalysisType {
  OVERVIEW
  COMMIT
  DIFF
  BRANCH
  HEALTH
}

model User {
  id           String   @id @default(uuid())
  githubId     String?  @unique
  username     String   @unique
  email        String?
  avatarUrl    String?
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt


  savedRepositories SavedRepository[]
  investigations    Investigation[]
  notes             Note[]
  bookmarks         Bookmark[]
  tags              Tag[]

  @@map("users")
}

model SavedRepository {
  id            String   @id @default(uuid())
  userId        String
  owner         String
  name          String
  fullName      String
  description   String?
  language      String?
  stars         Int      @default(0)
  forks         Int      @default(0)
  defaultBranch String   @default("main")
  savedAt       DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  investigations Investigation[]
  notes          Note[]
  bookmarks      Bookmark[]
  repositoryTags RepositoryTag[]
  aiAnalyses     AIAnalysis[]

  @@index([userId])
  @@index([userId, savedAt(sort: Desc)])
  @@index([userId, fullName])
  @@map("saved_repositories")
}

model Investigation {
  id           String   @id @default(uuid())
  userId       String
  repositoryId String
  title        String
  description  String?
  context      Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository SavedRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  notes      Note[]

  @@index([userId])
  @@index([repositoryId])
  @@index([userId, updatedAt(sort: Desc)])
  @@index([userId, repositoryId, updatedAt(sort: Desc)])
  @@map("investigations")
}

model Note {
  id              String     @id @default(uuid())
  userId          String
  investigationId String?
  repositoryId    String?
  targetType      TargetType
  targetRef       String
  content         String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  investigation Investigation?   @relation(fields: [investigationId], references: [id], onDelete: SetNull)
  repository    SavedRepository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([investigationId])
  @@index([repositoryId])
  @@index([userId, updatedAt(sort: Desc)])
  @@index([userId, repositoryId])
  @@index([userId, investigationId])
  @@map("notes")
}

model Bookmark {
  id           String     @id @default(uuid())
  userId       String
  repositoryId String
  targetType   TargetType
  targetRef    String
  label        String
  createdAt    DateTime   @default(now())

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository SavedRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([repositoryId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, repositoryId])
  @@map("bookmarks")
}

model Tag {
  id        String   @id @default(uuid())
  userId    String
  name      String
  color     String
  createdAt DateTime @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  repositoryTags RepositoryTag[]

  @@unique([userId, name])
  @@index([userId])
  @@map("tags")
}

model RepositoryTag {
  repositoryId String
  tagId        String

  repository SavedRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  tag        Tag             @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([repositoryId, tagId])
  @@index([tagId])
  @@index([repositoryId])
  @@map("repository_tags")
}

model AIAnalysis {
  id           String       @id @default(uuid())
  repositoryId String?
  analysisType AnalysisType
  contextHash  String
  prompt       String
  response     Json
  provider     String
  modelId      String
  tokenUsage   Json
  createdAt    DateTime     @default(now())
  expiresAt    DateTime?

  repository SavedRepository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)

  @@index([contextHash])
  @@index([repositoryId])
  @@index([contextHash, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@index([repositoryId, createdAt(sort: Desc)])
  @@map("ai_analyses")
}
